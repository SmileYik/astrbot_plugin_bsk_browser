{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true,
    "hint": "关闭后不再向模型注册浏览器工具，已有会话将在插件重载时释放。"
  },
  "llm_prompt_injection": {
    "description": "LLM提示词注入",
    "type": "text",
    "default": "",
    "hint": "当前用户具备浏览器操作权限时追加到系统提示词中；留空则不注入。"
  },
  "bsk_path": {
    "description": "bsk 命令位置",
    "type": "string",
    "default": "bsk",
    "hint": "bsk 命令行路径。留空或填 bsk 则从 PATH 查找；也可填写完整路径。"
  },
  "browser_instance_id": {
    "description": "目标浏览器",
    "type": "string",
    "default": "",
    "hint": "目标浏览器实例 ID。留空自动选择唯一已连接实例；多浏览器时填入 instance_id。"
  },
  "command_timeout_sec": {
    "description": "单条命令超时（秒）",
    "type": "float",
    "default": 60.0,
    "slider": {
      "min": 5,
      "max": 110,
      "step": 5
    },
    "hint": "单条命令超时时间（秒）。不作用于整页截图；最终超时有内置下限保护。默认 60。"
  },
  "fullpage_timeout_sec": {
    "description": "整页截图超时（秒）",
    "type": "float",
    "default": 120.0,
    "slider": {
      "min": 30,
      "max": 600,
      "step": 10
    },
    "hint": "整页长截图最大超时时间（秒）。受 AstrBot tool_call_timeout 约束；默认 120。"
  },
  "max_sessions": {
    "description": "最多同时开几个浏览器会话",
    "type": "int",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    },
    "hint": "最多同时保持的浏览器会话数量。超限将自动释放最久未使用的会话。默认 3。"
  },
  "admin_only": {
    "description": "只允许管理员使用",
    "type": "bool",
    "default": true,
    "hint": "仅允许 AstrBot 管理员调用浏览器工具。建议保持开启以保障安全。"
  },
  "allowed_users": {
    "description": "额外允许的用户 ID",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    },
    "hint": "额外允许使用浏览器工具的用户 ID 白名单。支持列表或英文逗号分隔。"
  },
  "session_scope": {
    "description": "会话隔离方式",
    "type": "string",
    "default": "umo",
    "options": [
      "umo",
      "user"
    ],
    "hint": "会话隔离粒度。umo：按聊天窗口隔离；user：按用户与窗口细分隔离。"
  },
  "idle_release_sec": {
    "description": "空闲多久释放浏览器（秒）",
    "type": "float",
    "default": 240.0,
    "slider": {
      "min": 60,
      "max": 299,
      "step": 10
    },
    "hint": "无操作空闲释放超时（秒）。bsk 后台 300 秒自动回收，故本项上限 299 秒。默认 240。"
  },
  "screenshot_dir": {
    "description": "截图保存目录",
    "type": "string",
    "default": "",
    "hint": "截图存储目录。留空则存放在插件数据目录 shots 下并定期清理。"
  },
  "journal_path": {
    "description": "会话记录文件位置",
    "type": "string",
    "default": "",
    "hint": "会话记录文件路径。留空则保存在插件数据目录 sessions.json，用于异常退出后的残留回收。"
  },
  "max_page_chars": {
    "description": "单次返回的页面文字上限",
    "type": "int",
    "default": 3000,
    "slider": {
      "min": 200,
      "max": 20000,
      "step": 100
    },
    "hint": "读取网页返回给模型的最大字符数（200~20000）。默认 3000。"
  },
  "enable_status": {
    "description": "注册环境自检工具（bsk_status）",
    "type": "bool",
    "default": true,
    "hint": "向模型注册 bsk_status 环境自检工具。关闭可节省模型提示词。默认开启。"
  },
  "lazy_debug_tool": {
    "description": "调试工具按需加载（建议保持开启）",
    "type": "bool",
    "default": true,
    "hint": "调试工具（bsk_debug）按需动态加载。开启后仅在模型调用 bsk_load_tools 时挂载当轮，节约上下文。默认开启。"
  },
  "enable_evaluate": {
    "description": "允许执行 JavaScript（高风险，默认关闭）",
    "type": "bool",
    "default": false,
    "hint": "允许执行自定义 JavaScript（bsk_evaluate）。具高安全风险，仅限完全信任环境开启。默认关闭。"
  },
  "evaluate_require_admin": {
    "description": "执行 JavaScript 仅限管理员（建议保持开启）",
    "type": "bool",
    "default": true,
    "hint": "执行 JavaScript 强制要求管理员权限。开启时即使开放普通用户仍禁止执行脚本。默认开启。"
  },
  "enable_request_id": {
    "description": "启用可恢复启动（建议保持开启）",
    "type": "bool",
    "default": true,
    "hint": "启用可恢复启动机制。支持异常中断后凭令牌找回并清理遗留窗口。默认开启。"
  },
  "log_max_output_length": {
    "description": "调试日志最大输出字符数",
    "type": "int",
    "default": 2048,
    "hint": "调试日志中返回值与命令输出的最大截断长度。默认 2048 字符，0 或负数表示不截断。"
  },
  "log_file_path": {
    "description": "日志转存文件路径",
    "type": "string",
    "default": "",
    "hint": "插件独立运行与调试日志文件路径。留空则不转存。"
  },
  "screenshot_compress_to_jpg": {
    "description": "截图压缩为 JPG 格式",
    "type": "bool",
    "default": false,
    "hint": "截图压缩为 JPG 格式以减小体积并加速发送；关闭时发送无损 PNG 原图。默认关闭。"
  },
  "screenshot_quality": {
    "description": "JPG 压缩质量",
    "type": "int",
    "default": 85,
    "slider": {
      "min": 1,
      "max": 100,
      "step": 5
    },
    "hint": "当开启 JPG 压缩时的图片质量（1~100）。默认 85。"
  },
  "fullpage_scope": {
    "description": "全页截图高度策略",
    "type": "string",
    "default": "current",
    "options": [
      "current",
      "follow"
    ],
    "hint": "整页长截图滚动策略。current：仅截取初始文档高度，防无限滚动；follow：持续滚动加载直到触底。"
  },
  "fullpage_max_height": {
    "description": "全页截图最大长度限制（像素）",
    "type": "int",
    "default": 8000,
    "slider": {
      "min": 0,
      "max": 30000,
      "step": 500
    },
    "hint": "整页长截图最大高度（像素）。超出自动截断；0 表示不限制。默认 8000。"
  },
  "site_whitelist": {
    "description": "普通用户网站与操作白名单",
    "type": "template_list",
    "default": [],
    "hint": "仅在关闭「只允许管理员使用」时生效。配置普通用户可访问的域名及允许调用的页内操作。未在名单内的域名将被禁止访问。",
    "templates": {
      "site_rule": {
        "name": "网站授权规则",
        "display_item": "domain",
        "items": {
          "domain": {
            "description": "允许访问的网站域名（例如 baidu.com、cn.bing.com）",
            "type": "string",
            "default": ""
          },
          "allowed_actions": {
            "description": "允许调用的页内操作（留空表示仅允许打开浏览，禁止一切页内操作）",
            "type": "list",
            "items": {
              "type": "string"
            },
            "default": [],
            "options": [
              "bsk_interact.*",
              "bsk_interact.click",
              "bsk_interact.fill",
              "bsk_interact.press",
              "bsk_interact.scroll",
              "bsk_interact.hover",
              "bsk_interact.drag",
              "bsk_interact.select",
              "bsk_interact.focus",
              "bsk_interact.blur",
              "bsk_inspect.*",
              "bsk_inspect.observe",
              "bsk_inspect.text",
              "bsk_inspect.search",
              "bsk_inspect.screenshot",
              "bsk_inspect.full_page",
              "bsk_inspect.table",
              "bsk_inspect.console",
              "bsk_page.*",
              "bsk_page.navigate",
              "bsk_page.reload",
              "bsk_page.back",
              "bsk_page.forward",
              "bsk_tabs.*",
              "bsk_tabs.list",
              "bsk_tabs.select",
              "bsk_tabs.create",
              "bsk_tabs.close"
            ],
            "labels": [
              "bsk_interact:",
              "\u00a0\u00a0\u00a0\u00a0click",
              "\u00a0\u00a0\u00a0\u00a0fill",
              "\u00a0\u00a0\u00a0\u00a0press",
              "\u00a0\u00a0\u00a0\u00a0scroll",
              "\u00a0\u00a0\u00a0\u00a0hover",
              "\u00a0\u00a0\u00a0\u00a0drag",
              "\u00a0\u00a0\u00a0\u00a0select",
              "\u00a0\u00a0\u00a0\u00a0focus",
              "\u00a0\u00a0\u00a0\u00a0blur",
              "bsk_inspect:",
              "\u00a0\u00a0\u00a0\u00a0observe",
              "\u00a0\u00a0\u00a0\u00a0text",
              "\u00a0\u00a0\u00a0\u00a0search",
              "\u00a0\u00a0\u00a0\u00a0screenshot",
              "\u00a0\u00a0\u00a0\u00a0full_page",
              "\u00a0\u00a0\u00a0\u00a0table",
              "\u00a0\u00a0\u00a0\u00a0console",
              "bsk_page:",
              "\u00a0\u00a0\u00a0\u00a0navigate",
              "\u00a0\u00a0\u00a0\u00a0reload",
              "\u00a0\u00a0\u00a0\u00a0back",
              "\u00a0\u00a0\u00a0\u00a0forward",
              "bsk_tabs:",
              "\u00a0\u00a0\u00a0\u00a0list",
              "\u00a0\u00a0\u00a0\u00a0select",
              "\u00a0\u00a0\u00a0\u00a0create",
              "\u00a0\u00a0\u00a0\u00a0close"
            ],
            "subtitles": [
              "放行所有元素交互动作",
              "点击按钮、链接等元素",
              "向输入框填写文本",
              "模拟按键操作",
              "滚动页面视口",
              "鼠标悬停至元素",
              "拖拽元素至目标位置",
              "下拉菜单选项选取",
              "使目标输入元素聚焦",
              "使当前焦点元素失焦",
              "放行所有内容检查动作",
              "观察页面语义结构与可用元素",
              "提取页面指定区域文本",
              "在页面内搜索关键词",
              "捕获当前视口屏幕截图",
              "捕获整页滚动长截图",
              "提取表格结构化数据",
              "查看浏览器控制台输出",
              "放行所有页面导航动作",
              "跳转至目标网址",
              "重新加载当前网页",
              "返回上一浏览历史",
              "前进至下一浏览历史",
              "放行所有标签页管理动作",
              "列出当前窗口所有标签页",
              "切换当前活动标签页焦点",
              "新建空白或指定网页标签页",
              "关闭当前或指定标签页"
            ]
          }
        }
      }
    }
  }
}

